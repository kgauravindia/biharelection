# =========================================================================
# BiharElection.com - Environment Variables Sample (.env.example)
# Copy to `.env` or set in your hosting control panel / server environment
# =========================================================================

# Database Credentials
DB_HOST=localhost
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password
DB_CHARSET=utf8mb4

# SMS Gateway Credentials (OfferPlant Engine)
SMS_AUTH_KEY=your_sms_gateway_auth_key_here
SMS_SENDER_ID=BIHELE
SMS_TEMPLATE_NAME=BIHELE_OTP
SMS_API_URL=http://msg.morg.in/rest/services/sendSMS/sendGroupSms

# Google AdSense
GOOGLE_ADS_ENABLED=false
GOOGLE_ADSENSE_CLIENT=ca-pub-0000000000000000
GOOGLE_AD_SLOT_HEADER=0000000001
GOOGLE_AD_SLOT_INFEED=0000000002
GOOGLE_AD_SLOT_SIDEBAR=0000000003
GOOGLE_AD_SLOT_TABLE=0000000004
GOOGLE_AD_SLOT_FOOTER=0000000005

# Admin Initialization Password (Optional)
DEFAULT_ADMIN_PASS=YourSecureAdminPassword2026!
