# =============================================================================
# BiharElection.com - Production Server Apache Configuration (.htaccess)
# =============================================================================

# Disable directory browsing
Options -Indexes

# Set default character set
AddDefaultCharset UTF-8

# Protect sensitive files & directories
<FilesMatch "(^\.env|config\.local\.php|\.sql|\.git|\.log|\.lock|database_setup)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# -----------------------------------------------------------------------------
# URL Rewriting & Routing
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    # RewriteBase is omitted so Apache auto-resolves relative to current directory (works on both domain root and subfolders)

    # Optional: Force HTTPS (uncomment if SSL is active and not handled by Cloudflare/Load Balancer)
    # RewriteCond %{HTTPS} off
    # RewriteCond %{HTTP:X-Forwarded-Proto} !https
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Ensure trailing slash for physical directories
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.*[^/])$ $1/ [L,R=301]

    # Don't rewrite actual existing physical files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # -------------------------------------------------------------
    # Legacy /sitemap/ Folder -> 301 Redirect to Root Sitemaps
    # -------------------------------------------------------------
    RewriteRule ^sitemap/sitemap[-_]?index\.xml$ sitemap_index.xml [L,R=301,NC]
    RewriteRule ^sitemap/(.+)\.xml$ $1.xml [L,R=301,NC]
    RewriteRule ^sitemap/?$ sitemap_index.xml [L,R=301,NC]

    # Catch any relative advertise.php or asset requests from sub-routes
    # -------------------------------------------------------------
    # Blog, Category & Tag Archives (e.g. /blog, /category/lok-sabha, /tag/saran)
    # -------------------------------------------------------------
    RewriteRule ^blog/?$ blog.php [L,QSA]
    RewriteRule ^blog/(.+)/?$ blog.php?slug=$1 [L,QSA]
    RewriteRule ^category/?$ blog.php [L,QSA]
    RewriteRule ^category/(.+)/?$ blog.php?category=$1 [L,QSA]
    RewriteRule ^tag/?$ blog.php [L,QSA]
    RewriteRule ^tag/(.+)/?$ blog.php?tag=$1 [L,QSA]
    RewriteRule ^tags/?$ blog.php [L,QSA]
    RewriteRule ^tags/(.+)/?$ blog.php?tag=$1 [L,QSA]

    # -------------------------------------------------------------
    # 1. MLA & Assembly Constituencies (e.g. /mla, /mla/118-chapra, /constituency/118-chapra)
    # -------------------------------------------------------------
    RewriteRule ^mla/?$ mla.php [L,QSA]
    RewriteRule ^mla/([0-9]+)-([a-zA-Z0-9_-]+)/?$ vidhan-sabha.php?ac=$1&slug=$2 [L,QSA]
    RewriteRule ^mla/([a-zA-Z0-9_-]+)/?$ vidhan-sabha.php?slug=$1 [L,QSA]

    RewriteRule ^constituencies/?$ mla.php [L,QSA]
    RewriteRule ^constituency/?$ mla.php [L,QSA]
    RewriteRule ^constituency/([0-9]+)-([a-zA-Z0-9_-]+)/?$ vidhan-sabha.php?ac=$1&slug=$2 [L,QSA]
    RewriteRule ^constituency/([a-zA-Z0-9_-]+)/?$ vidhan-sabha.php?slug=$1 [L,QSA]

    RewriteRule ^vidhan-sabha/?$ mla.php [L,QSA]
    RewriteRule ^vidhan-sabha/([0-9]+)-([a-zA-Z0-9_-]+)/?$ vidhan-sabha.php?ac=$1&slug=$2 [L,QSA]
    RewriteRule ^vidhan-sabha/([a-zA-Z0-9_-]+)/?$ vidhan-sabha.php?slug=$1 [L,QSA]

    # -------------------------------------------------------------
    # 2. MP (Lok Sabha & Rajya Sabha) (e.g. /mp, /lok-sabha, /rajya-sabha)
    # -------------------------------------------------------------
    RewriteRule ^mp/?$ mp.php [L,QSA]
    RewriteRule ^mp/([a-zA-Z0-9_-]+)/?$ mp.php?slug=$1 [L,QSA]
    RewriteRule ^lok-sabha/?$ mp.php?house=loksabha [L,QSA]
    RewriteRule ^lok-sabha/([a-zA-Z0-9_-]+)/?$ mp.php?house=loksabha&slug=$1 [L,QSA]
    RewriteRule ^rajya-sabha/?$ mp.php?house=rajyasabha [L,QSA]
    RewriteRule ^rajya-sabha/([a-zA-Z0-9_-]+)/?$ mp.php?house=rajyasabha&slug=$1 [L,QSA]

    # -------------------------------------------------------------
    # 3. MLC (Vidhan Parishad) (e.g. /mlc, /vidhan-parishad)
    # -------------------------------------------------------------
    RewriteRule ^mlc/?$ mlc.php [L,QSA]
    RewriteRule ^mlc/([a-zA-Z0-9_-]+)/?$ mlc.php?slug=$1 [L,QSA]
    RewriteRule ^vidhan-parishad/?$ mlc.php [L,QSA]
    RewriteRule ^vidhan-parishad/([a-zA-Z0-9_-]+)/?$ mlc.php?slug=$1 [L,QSA]

    # -------------------------------------------------------------
    # 4. District Hubs & Drilldowns (e.g. /district/saran, /district/ac-chapra, /district/chapra/sandha)
    # -------------------------------------------------------------
    RewriteRule ^district/?$ index.php [L,QSA]
    # Handle /district/ac-chapra or /district/ac-118-chapra
    RewriteRule ^district/ac-([0-9]+)-([a-zA-Z0-9_-]+)/?$ vidhan-sabha.php?ac=$1&slug=$2 [L,QSA]
    RewriteRule ^district/ac-([a-zA-Z0-9_-]+)/?$ vidhan-sabha.php?slug=$1 [L,QSA]
    # Handle /district/chapra/sandha or /district/saran/sandha (District + Panchayat)
    RewriteRule ^district/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ panchayat.php?district=$1&panchayat=$2 [L,QSA]
    # Handle /district/saran
    RewriteRule ^district/([a-zA-Z0-9_-]+)/?$ district.php?slug=$1 [L,QSA]

    # -------------------------------------------------------------
    # 5. CD Blocks & Sub-districts (e.g. /block/amnour, /block/saran/amnour, /blocks)
    # -------------------------------------------------------------
    RewriteRule ^blocks/?$ block.php [L,QSA]
    RewriteRule ^block/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ block.php?district=$1&slug=$2 [L,QSA]
    RewriteRule ^block/([a-zA-Z0-9_-]+)/?$ block.php?slug=$1 [L,QSA]

    # -------------------------------------------------------------
    # 6. Mukhiya & Sarpanch Legacy Aliases -> Unified Panchayat System
    # -------------------------------------------------------------
    RewriteRule ^mukhiya/?$ panchayat.php [L,QSA]
    RewriteRule ^mukhiya/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ panchayat.php?district=$1&panchayat=$2 [L,QSA]
    RewriteRule ^mukhiya/([a-zA-Z0-9_-]+)/?$ panchayat.php?slug=$1 [L,QSA]

    RewriteRule ^sarpanch/?$ panchayat.php [L,QSA]
    RewriteRule ^sarpanch/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ panchayat.php?district=$1&panchayat=$2 [L,QSA]
    RewriteRule ^sarpanch/([a-zA-Z0-9_-]+)/?$ panchayat.php?slug=$1 [L,QSA]

    # -------------------------------------------------------------
    # 8. Zila Parishad / Jila Parisad (e.g. /zila-parishad, /zila-parishad/saran, /zila-parishad/siwan/1)
    # -------------------------------------------------------------
    RewriteRule ^zila-parishad/?$ zila-parishad.php [L,QSA]
    RewriteRule ^zila-parishad/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ zila-parishad.php?district=$1&ward=$2 [L,QSA]
    RewriteRule ^zila-parishad/([a-zA-Z0-9_-]+)/?$ zila-parishad.php?district=$1 [L,QSA]
    RewriteRule ^jila-parisad/?$ zila-parishad.php [L,QSA]
    RewriteRule ^jila-parisad/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ zila-parishad.php?district=$1&ward=$2 [L,QSA]
    RewriteRule ^jila-parisad/([a-zA-Z0-9_-]+)/?$ zila-parishad.php?district=$1 [L,QSA]
    RewriteRule ^jila-parishad/?$ zila-parishad.php [L,QSA]
    RewriteRule ^jila-parishad/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ zila-parishad.php?district=$1&ward=$2 [L,QSA]
    RewriteRule ^jila-parishad/([a-zA-Z0-9_-]+)/?$ zila-parishad.php?district=$1 [L,QSA]

    # -------------------------------------------------------------
    # 9. Panchayat Samiti / Block Pramukh (e.g. /panchayat-samiti, /panchayat-samiti/saran, /panchayat-samiti/saran/chapra)
    # -------------------------------------------------------------
    RewriteRule ^panchayat-samiti/?$ panchayat-samiti.php [L,QSA]
    RewriteRule ^panchayat-samiti/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ panchayat-samiti.php?district=$1&block=$2 [L,QSA]
    RewriteRule ^panchayat-samiti/([a-zA-Z0-9_-]+)/?$ panchayat-samiti.php?district=$1 [L,QSA]

    # -------------------------------------------------------------
    # 10. Gram Panchayats (e.g. /panchayat, /panchayat/saran, /panchayat/patna/maner/khaspur, /patna/maner/khaspur)
    # -------------------------------------------------------------
    RewriteRule ^panchayats/?$ panchayat.php [L,QSA]
    RewriteRule ^panchayat/?$ panchayat.php [L,QSA]
    RewriteRule ^panchayat/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ panchayat.php?district=$1&block=$2&panchayat=$3 [L,QSA]
    RewriteRule ^panchayat/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ panchayat.php?district=$1&panchayat=$2 [L,QSA]
    RewriteRule ^panchayat/([a-zA-Z0-9_-]+)/?$ panchayat.php?slug=$1 [L,QSA]

    # District 3-segment & 2-segment fallback to Panchayat Profile
    RewriteRule ^district/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ panchayat.php?district=$1&block=$2&panchayat=$3 [L,QSA]

    # Clean 3-segment root routing (e.g. /patna/maner/khaspur, /saran/chapra/sandha)
    RewriteRule ^([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ panchayat.php?district=$1&block=$2&panchayat=$3 [L,QSA]

    # -------------------------------------------------------------
    # 11. Census Hub (e.g. /census, /census/saran, /census/saran/chapra)
    # -------------------------------------------------------------
    RewriteRule ^census/?$ census.php [L,QSA]
    RewriteRule ^census/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ census.php?district=$1&subdistrict=$2 [L,QSA]
    RewriteRule ^census/([a-zA-Z0-9_-]+)/?$ census.php?district=$1 [L,QSA]

    # -------------------------------------------------------------
    # 12. Candidates, Auth & Other Pages
    # -------------------------------------------------------------
    RewriteRule ^candidate/([a-zA-Z0-9_-]+)/?$ candidate.php?slug=$1 [L,QSA]
    RewriteRule ^representatives/?$ representatives.php [L,QSA]
    RewriteRule ^login/?$ login.php [L,QSA]
    RewriteRule ^register/?$ register.php [L,QSA]
    RewriteRule ^forgot-password/?$ forgot-password.php [L,QSA]
    RewriteRule ^verify-otp/?$ verify-otp.php [L,QSA]
    RewriteRule ^dashboard/?$ dashboard.php [L,QSA]
    RewriteRule ^edit-profile/?$ edit-profile.php [L,QSA]
    RewriteRule ^user/([a-zA-Z0-9_@.-]+)/?$ user_profile.php?handle=$1 [L,QSA]
    RewriteRule ^profile/([a-zA-Z0-9_@.-]+)/?$ user_profile.php?handle=$1 [L,QSA]
    RewriteRule ^profile/?$ dashboard.php [L,QSA]
    RewriteRule ^logout/?$ logout.php [L,QSA]
    RewriteRule ^terms-and-conditions/?$ terms-and-conditions.php [L,QSA]
    RewriteRule ^terms/?$ terms-and-conditions.php [L,QSA]
    RewriteRule ^privacy-policy/?$ privacy-policy.php [L,QSA]
    RewriteRule ^privacy/?$ privacy-policy.php [L,QSA]
    RewriteRule ^disclaimer/?$ disclaimer.php [L,QSA]
    RewriteRule ^mission-and-vision/?$ mission-and-vision.php [L,QSA]
    RewriteRule ^about/?$ about.php [L,QSA]
    RewriteRule ^about-us/?$ about.php [L,QSA]
    RewriteRule ^contact/?$ contact.php [L,QSA]
    RewriteRule ^contact-us/?$ contact.php [L,QSA]
    RewriteRule ^search-pin-code/?$ search-pin-code.php [L,QSA]
    RewriteRule ^pincode/?$ search-pin-code.php [L,QSA]
    RewriteRule ^advertise/?$ advertise.php [L,QSA]
    RewriteRule ^whatsapp/?$ whatsapp.php [L,QSA]
    RewriteRule ^404/?$ 404.php [L,QSA]

    # -------------------------------------------------------------
    # 12. Unrecognized Root Slugs / Legacy WordPress URLs -> 301 Redirection
    # -------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.+)$ 404.php?request_uri=$1 [L,QSA]
</IfModule>

# -----------------------------------------------------------------------------
# Custom Error Documents
# -----------------------------------------------------------------------------
ErrorDocument 404 /404.php

# -----------------------------------------------------------------------------
# Security Headers
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# -----------------------------------------------------------------------------
# Performance: GZIP / Deflate Compression
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# -----------------------------------------------------------------------------
# Performance: Browser Caching (Expires Headers)
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS & JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
