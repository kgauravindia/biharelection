<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /biharelection/

    # Ensure trailing slash for physical subdirectories
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^(.*[^/])$ $1/ [L,R=301]

    # Don't rewrite actual existing physical files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Catch any relative advertise.php or asset requests from sub-routes
    RewriteRule ^(?:mla|district|constituency|vidhan-sabha|panchayat|mukhiya|sarpanch|zila-parishad|panchayat-samiti|census|candidate)/advertise(?:\.php)?$ advertise.php [L,QSA]

    # -------------------------------------------------------------
    # 0. Blog Sitemaps & Feeds (Shifted to /blog/ folder)
    # -------------------------------------------------------------
    RewriteRule ^post-sitemap([0-9]*)\.xml$ blog/post-sitemap$1.xml [R=301,L]
    RewriteRule ^page-sitemap([0-9]*)\.xml$ blog/page-sitemap$1.xml [R=301,L]
    RewriteRule ^category-sitemap([0-9]*)\.xml$ blog/category-sitemap$1.xml [R=301,L]
    RewriteRule ^author-sitemap([0-9]*)\.xml$ blog/author-sitemap$1.xml [R=301,L]
    RewriteRule ^sitemap_index\.xml$ blog/sitemap_index.xml [R=301,L]


    # -------------------------------------------------------------
    # 1. MLA & Assembly Constituencies (e.g. /mla/118-chapra, /mla/chapra, /constituency/118-chapra)
    # -------------------------------------------------------------
    RewriteRule ^mla/?$ vidhan-sabha.php [L,QSA]
    RewriteRule ^mla/([0-9]+)-([a-zA-Z0-9_-]+)/?$ vidhan-sabha.php?ac=$1&slug=$2 [L,QSA]
    RewriteRule ^mla/([a-zA-Z0-9_-]+)/?$ vidhan-sabha.php?slug=$1 [L,QSA]

    RewriteRule ^constituency/?$ vidhan-sabha.php [L,QSA]
    RewriteRule ^constituency/([0-9]+)-([a-zA-Z0-9_-]+)/?$ vidhan-sabha.php?ac=$1&slug=$2 [L,QSA]
    RewriteRule ^constituency/([a-zA-Z0-9_-]+)/?$ vidhan-sabha.php?slug=$1 [L,QSA]

    RewriteRule ^vidhan-sabha/?$ vidhan-sabha.php [L,QSA]
    RewriteRule ^vidhan-sabha/([0-9]+)-([a-zA-Z0-9_-]+)/?$ vidhan-sabha.php?ac=$1&slug=$2 [L,QSA]
    RewriteRule ^vidhan-sabha/([a-zA-Z0-9_-]+)/?$ vidhan-sabha.php?slug=$1 [L,QSA]

    # -------------------------------------------------------------
    # 2. MP (Lok Sabha & Rajya Sabha) (e.g. /mp, /mp/saran, /lok-sabha/saran)
    # -------------------------------------------------------------
    RewriteRule ^mp/?$ representatives.php?tab=loksabha [L,QSA]
    RewriteRule ^mp/([a-zA-Z0-9_-]+)/?$ representatives.php?tab=loksabha&slug=$1 [L,QSA]
    RewriteRule ^lok-sabha/?$ representatives.php?tab=loksabha [L,QSA]
    RewriteRule ^lok-sabha/([a-zA-Z0-9_-]+)/?$ representatives.php?tab=loksabha&slug=$1 [L,QSA]
    RewriteRule ^rajya-sabha/?$ representatives.php?tab=rajyasabha [L,QSA]

    # -------------------------------------------------------------
    # 3. MLC (Vidhan Parishad) (e.g. /mlc, /mlc/saran, /vidhan-parishad)
    # -------------------------------------------------------------
    RewriteRule ^mlc/?$ representatives.php?tab=mlc [L,QSA]
    RewriteRule ^mlc/([a-zA-Z0-9_-]+)/?$ representatives.php?tab=mlc&slug=$1 [L,QSA]
    RewriteRule ^vidhan-parishad/?$ representatives.php?tab=mlc [L,QSA]
    RewriteRule ^vidhan-parishad/([a-zA-Z0-9_-]+)/?$ representatives.php?tab=mlc&slug=$1 [L,QSA]

    # -------------------------------------------------------------
    # 4. District Hubs & Drilldowns (e.g. /district/saran, /district/ac-chapra, /district/chapra/sandha)
    # -------------------------------------------------------------
    RewriteRule ^district/?$ index.php [L,QSA]
    # Handle /district/ac-chapra or /district/ac-118-chapra
    RewriteRule ^district/ac-([0-9]+)-([a-zA-Z0-9_-]+)/?$ vidhan-sabha.php?ac=$1&slug=$2 [L,QSA]
    RewriteRule ^district/ac-([a-zA-Z0-9_-]+)/?$ vidhan-sabha.php?slug=$1 [L,QSA]
    # Handle /district/chapra/sandha or /district/saran/sandha (District + Panchayat)
    RewriteRule ^district/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ panchayat.php?district=$1&panchayat=$2 [L,QSA]
    # Handle /district/saran
    RewriteRule ^district/([a-zA-Z0-9_-]+)/?$ district.php?slug=$1 [L,QSA]

    # -------------------------------------------------------------
    # 5. Mukhiya Directory (e.g. /mukhiya, /mukhiya/saran, /mukhiya/saran/sandha)
    # -------------------------------------------------------------
    RewriteRule ^mukhiya/?$ panchayat.php?tab=mukhiya [L,QSA]
    RewriteRule ^mukhiya/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ panchayat.php?tab=mukhiya&district=$1&panchayat=$2 [L,QSA]
    RewriteRule ^mukhiya/([a-zA-Z0-9_-]+)/?$ panchayat.php?tab=mukhiya&district=$1 [L,QSA]

    # -------------------------------------------------------------
    # 6. Sarpanch Directory (e.g. /sarpanch, /sarpanch/saran, /sarpanch/saran/sandha)
    # -------------------------------------------------------------
    RewriteRule ^sarpanch/?$ panchayat.php?tab=sarpanch [L,QSA]
    RewriteRule ^sarpanch/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ panchayat.php?tab=sarpanch&district=$1&panchayat=$2 [L,QSA]
    RewriteRule ^sarpanch/([a-zA-Z0-9_-]+)/?$ panchayat.php?tab=sarpanch&district=$1 [L,QSA]

    # -------------------------------------------------------------
    # 7. Zila Parishad / Jila Parisad (e.g. /zila-parishad, /zila-parishad/saran, /jila-parisad/saran)
    # -------------------------------------------------------------
    RewriteRule ^zila-parishad/?$ panchayat.php?tab=zila [L,QSA]
    RewriteRule ^zila-parishad/([a-zA-Z0-9_-]+)/?$ panchayat.php?tab=zila&district=$1 [L,QSA]
    RewriteRule ^jila-parisad/?$ panchayat.php?tab=zila [L,QSA]
    RewriteRule ^jila-parisad/([a-zA-Z0-9_-]+)/?$ panchayat.php?tab=zila&district=$1 [L,QSA]
    RewriteRule ^jila-parishad/?$ panchayat.php?tab=zila [L,QSA]
    RewriteRule ^jila-parishad/([a-zA-Z0-9_-]+)/?$ panchayat.php?tab=zila&district=$1 [L,QSA]

    # -------------------------------------------------------------
    # 8. Panchayat Samiti / Block Pramukh (e.g. /panchayat-samiti, /panchayat-samiti/saran, /panchayat-samiti/saran/chapra)
    # -------------------------------------------------------------
    RewriteRule ^panchayat-samiti/?$ panchayat.php?tab=samiti [L,QSA]
    RewriteRule ^panchayat-samiti/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ panchayat.php?tab=samiti&district=$1&block=$2 [L,QSA]
    RewriteRule ^panchayat-samiti/([a-zA-Z0-9_-]+)/?$ panchayat.php?tab=samiti&district=$1 [L,QSA]

    # -------------------------------------------------------------
    # 9. General Panchayat Hub (e.g. /panchayat, /panchayat/saran, /panchayat/saran/sandha)
    # -------------------------------------------------------------
    RewriteRule ^panchayat/?$ panchayat.php [L,QSA]
    RewriteRule ^panchayat/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ panchayat.php?district=$1&panchayat=$2 [L,QSA]
    RewriteRule ^panchayat/([a-zA-Z0-9_-]+)/?$ panchayat.php?district=$1 [L,QSA]

    # -------------------------------------------------------------
    # 10. Census Hub (e.g. /census, /census/saran, /census/saran/chapra)
    # -------------------------------------------------------------
    RewriteRule ^census/?$ census.php [L,QSA]
    RewriteRule ^census/([a-zA-Z0-9_-]+)/([a-zA-Z0-9_-]+)/?$ census.php?district=$1&subdistrict=$2 [L,QSA]
    RewriteRule ^census/([a-zA-Z0-9_-]+)/?$ census.php?district=$1 [L,QSA]

    # -------------------------------------------------------------
    # 11. Candidates & Other Sections
    # -------------------------------------------------------------
    RewriteRule ^candidate/([a-zA-Z0-9_-]+)/?$ candidate.php?slug=$1 [L,QSA]
    RewriteRule ^representatives/?$ representatives.php [L,QSA]
    RewriteRule ^login/?$ login.php [L,QSA]
    RewriteRule ^register/?$ register.php [L,QSA]
    RewriteRule ^dashboard/?$ dashboard.php [L,QSA]
    RewriteRule ^logout/?$ logout.php [L,QSA]
    RewriteRule ^terms-and-conditions/?$ terms-and-conditions.php [L,QSA]
    RewriteRule ^terms/?$ terms-and-conditions.php [L,QSA]
    RewriteRule ^privacy-policy/?$ privacy-policy.php [L,QSA]
    RewriteRule ^privacy/?$ privacy-policy.php [L,QSA]
    RewriteRule ^disclaimer/?$ disclaimer.php [L,QSA]
    RewriteRule ^mission-and-vision/?$ mission-and-vision.php [L,QSA]
    RewriteRule ^about/?$ mission-and-vision.php [L,QSA]
    RewriteRule ^about-us/?$ mission-and-vision.php [L,QSA]
    RewriteRule ^advertise/?$ advertise.php [L,QSA]
    RewriteRule ^whatsapp/?$ whatsapp.php [L,QSA]
    RewriteRule ^404/?$ 404.php [L,QSA]
</IfModule>

# Custom 404 Error Handler
ErrorDocument 404 /biharelection/404.php

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>
